// Metadados do jogo sintetico dos testes (BE-52): versao, empresa, descricao e manifesto. Um
// executavel pequeno, sem assinatura e SEM metadados e o perfil que o aprendizado de maquina do
// Defender costuma barrar (falso positivo Bearfoos.A!ml, erro 225). Nunca entra no instalador.
// Nao usa #include (rc.exe do SDK e windres do MinGW leem igual); so ASCII.
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Sofa (testes de integracao)"
            VALUE "FileDescription", "Jogo sintetico dos testes do Sofa"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "sofa-test-game"
            VALUE "LegalCopyright", "Copyright (c) Sofa"
            VALUE "OriginalFilename", "sofa-test-game.exe"
            VALUE "ProductName", "Sofa"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
1 24 "test-game.manifest"
