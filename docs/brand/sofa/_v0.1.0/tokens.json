{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Sofá",
    "slug": "sofa",
    "tagline": "Do sofá, direto pro jogo."
  },
  "color": {
    "brand-ink": {
      "$value": "#14102B",
      "$type": "color"
    },
    "brand-surface": {
      "$value": "#221B47",
      "$type": "color"
    },
    "brand-surface-raised": {
      "$value": "#2C2459",
      "$type": "color"
    },
    "brand-text": {
      "$value": "#F5F1FF",
      "$type": "color"
    },
    "brand-text-muted": {
      "$value": "#BDB4E0",
      "$type": "color"
    },
    "brand-primary": {
      "$value": "#FFB547",
      "$type": "color"
    },
    "brand-on-primary": {
      "$value": "#14102B",
      "$type": "color"
    },
    "brand-secondary": {
      "$value": "#8F7DFF",
      "$type": "color"
    },
    "brand-danger": {
      "$value": "#FF7A85",
      "$type": "color"
    },
    "brand-success": {
      "$value": "#5FE3A1",
      "$type": "color"
    },
    "brand-scrim": {
      "$value": "#0B081C",
      "$type": "color"
    }
  },
  "contrast": [
    {
      "fg": "text",
      "bg": "ink",
      "ratio": 16.6,
      "min": 4.5,
      "use": "Corpo e títulos",
      "pass": true
    },
    {
      "fg": "text",
      "bg": "surface",
      "ratio": 14.37,
      "min": 4.5,
      "use": "Texto em cards e barras",
      "pass": true
    },
    {
      "fg": "text",
      "bg": "raised",
      "ratio": 12.57,
      "min": 4.5,
      "use": "Texto em menus e diálogos",
      "pass": true
    },
    {
      "fg": "muted",
      "bg": "ink",
      "ratio": 9.46,
      "min": 4.5,
      "use": "Metadados, dicas de botão",
      "pass": true
    },
    {
      "fg": "muted",
      "bg": "surface",
      "ratio": 8.18,
      "min": 4.5,
      "use": "Metadados em cards",
      "pass": true
    },
    {
      "fg": "muted",
      "bg": "raised",
      "ratio": 7.16,
      "min": 4.5,
      "use": "Metadados em diálogos",
      "pass": true
    },
    {
      "fg": "primary",
      "bg": "ink",
      "ratio": 10.5,
      "min": 4.5,
      "use": "Rótulo ativo, anel de foco",
      "pass": true
    },
    {
      "fg": "primary",
      "bg": "surface",
      "ratio": 9.08,
      "min": 3,
      "use": "Anel de foco sobre card",
      "pass": true
    },
    {
      "fg": "primary",
      "bg": "raised",
      "ratio": 7.95,
      "min": 3,
      "use": "Anel de foco em diálogo",
      "pass": true
    },
    {
      "fg": "onprimary",
      "bg": "primary",
      "ratio": 10.5,
      "min": 4.5,
      "use": "Texto em botão de ação",
      "pass": true
    },
    {
      "fg": "secondary",
      "bg": "ink",
      "ratio": 5.75,
      "min": 4.5,
      "use": "Destaque secundário",
      "pass": true
    },
    {
      "fg": "secondary",
      "bg": "surface",
      "ratio": 4.97,
      "min": 3,
      "use": "Ícone ou detalhe (não texto)",
      "pass": true
    },
    {
      "fg": "danger",
      "bg": "raised",
      "ratio": 5.57,
      "min": 4.5,
      "use": "Ações destrutivas e erro",
      "pass": true
    },
    {
      "fg": "success",
      "bg": "raised",
      "ratio": 8.64,
      "min": 4.5,
      "use": "Confirmação",
      "pass": true
    }
  ],
  "font": {
    "display": {
      "family": "Sora",
      "fallback": [
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ],
      "weights": [
        600,
        700,
        800
      ],
      "files": [
        "Sora-600.woff2",
        "Sora-700.woff2",
        "Sora-800.woff2"
      ],
      "license": "OFL 1.1"
    },
    "text": {
      "family": "Figtree",
      "fallback": [
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ],
      "weights": [
        400,
        600,
        700
      ],
      "files": [
        "Figtree-400.woff2",
        "Figtree-600.woff2",
        "Figtree-700.woff2"
      ],
      "license": "OFL 1.1"
    }
  },
  "typeScale1080": {
    "unit": "px a 1080p; em 4K multiplicar por 2 (usar --u)",
    "caption": {
      "size": 24,
      "line": 32,
      "weight": 400,
      "family": "text",
      "note": "mínimo absoluto"
    },
    "body": {
      "size": 28,
      "line": 38,
      "weight": 400,
      "family": "text"
    },
    "label": {
      "size": 32,
      "line": 40,
      "weight": 600,
      "family": "text"
    },
    "cardTitle": {
      "size": 40,
      "line": 48,
      "weight": 700,
      "family": "display"
    },
    "heading": {
      "size": 48,
      "line": 56,
      "weight": 700,
      "family": "display"
    },
    "display": {
      "size": 72,
      "line": 80,
      "weight": 800,
      "family": "display"
    },
    "hero": {
      "size": 96,
      "line": 104,
      "weight": 800,
      "family": "display"
    }
  },
  "scaling": {
    "rule": "--u = 100vh / 1080. Todo tamanho é calc(N * var(--u)). 1080p: 1px por unidade, 4K: 2px.",
    "safeArea": {
      "x": "5vw",
      "y": "5vh"
    }
  },
  "space": {
    "1": 8,
    "2": 16,
    "3": 24,
    "4": 32,
    "6": 48,
    "8": 64,
    "12": 96,
    "unit": "px a 1080p"
  },
  "radius": {
    "card": 20,
    "cardFocus": 24,
    "button": 16,
    "pill": 999,
    "dialog": 28,
    "unit": "px a 1080p"
  },
  "shadow": {
    "card": "0 12px 32px rgba(11,8,28,.55)",
    "dialog": "0 24px 64px rgba(11,8,28,.7)",
    "spotlight": "0 0 120px 10px rgba(255,181,71,.40)"
  },
  "gradient": {
    "spotlight": "radial-gradient(ellipse 60% 55% at 50% 30%, rgba(255,181,71,.16), rgba(255,181,71,0) 70%)",
    "coverScrim": "linear-gradient(180deg, rgba(11,8,28,0) 45%, rgba(11,8,28,.82) 100%)"
  },
  "focus": {
    "ring": "0 0 0 6px #14102B, 0 0 0 14px #FFB547",
    "ringWidth": 14,
    "scale": 1.06,
    "glow": "0 0 120px 10px rgba(255,181,71,.40)",
    "dimOthers": 0.72,
    "rule": "Sempre exatamente um item em foco. Anel duplo: 6 px de tinta escura e 14 px âmbar, assim o âmbar nunca disputa com a capa."
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 320
    },
    "easing": {
      "out": "cubic-bezier(.22,1,.36,1)",
      "inOut": "cubic-bezier(.65,0,.35,1)"
    },
    "focusMove": "transform 160ms out, box-shadow 160ms out",
    "reducedMotion": "Sem scale nem glow animado; troca de foco instantânea com o anel."
  },
  "icon": {
    "sizes": [
      16,
      24,
      32,
      48,
      64,
      128,
      256,
      512
    ],
    "smallVariantUpTo": 32
  }
}