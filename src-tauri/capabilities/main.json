{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability unica do Sofa: a janela main so chama os 30 comandos da lista fechada e ouve eventos. Sem core:default, sem core:window, sem plugins, sem remote (SEC-04, SEC-05).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-library-get",
    "allow-library-refresh",
    "allow-library-add-manual",
    "allow-library-hidden",
    "allow-game-rename",
    "allow-game-restore-name",
    "allow-game-hide",
    "allow-game-unhide",
    "allow-fs-list-dir",
    "allow-session-get",
    "allow-session-launch",
    "allow-session-launch-with-uac",
    "allow-session-replace",
    "allow-session-return-to-game",
    "allow-session-close",
    "allow-session-force-close",
    "allow-session-retry",
    "allow-session-dismiss",
    "allow-volume-get",
    "allow-volume-step",
    "allow-volume-toggle-mute",
    "allow-power-capabilities",
    "allow-power-prepare",
    "allow-power-execute",
    "allow-settings-get",
    "allow-settings-set-autostart",
    "allow-settings-set-monitor",
    "allow-display-monitors",
    "allow-input-status",
    "allow-app-exit",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
