{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SofaLauncher",
  "version": "0.2.0",
  "identifier": "app.sofa.launcher",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' cover: http://cover.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' cover: http://cover.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5173 http://127.0.0.1:5173; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SofaLauncher",
    "copyright": "Copyright (c) SofaLauncher",
    "category": "Game",
    "shortDescription": "SofaLauncher: launcher de jogos para a TV",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/brand/sofa/assets/fonts/OFL-Figtree.txt": "licenses/OFL-Figtree.txt",
      "../docs/brand/sofa/assets/fonts/OFL-Sora.txt": "licenses/OFL-Sora.txt"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installMode": "perMachine",
        "installerIcon": "../docs/brand/sofa/assets/icon.ico",
        "languages": [
          "PortugueseBR"
        ],
        "customLanguageFiles": {
          "PortugueseBR": "windows/PortugueseBR.nsh"
        },
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "mainBinaryName": "sofa"
}
